{
  "schema_version": 2,
  "principle": "Sikkerhedsgates er hårde; polish repareres. Lavrisiko kan publiceres på ét verificeret bærende claim med gyldig evidensklasse. High-risk/fairness har skærpede krav.",
  "evidence_policy": {
    "low_risk_any_of": [
      "authoritative_primary",
      "original_wire",
      "strong_original_editorial",
      "two_independent_trustworthy"
    ],
    "min_verified_material_claims": 1,
    "high_risk_requires_stronger_evidence": true,
    "named_accused_crime_requires_primary": true,
    "discovery_only_never_evidence": true
  },
  "stages": [
    {
      "id": "newsdesk",
      "label": "Newsdesk",
      "kind": "selection",
      "hard_gate": false,
      "requirements": [
        {
          "key": "max_story_candidates",
          "label": "Historier valgt pr. cycle",
          "value": 1,
          "unit": "artikel",
          "adjustable": true
        },
        {
          "key": "min_start_sources",
          "label": "Troværdige startkilder",
          "value": 1,
          "unit": "kilde",
          "adjustable": true
        }
      ]
    },
    {
      "id": "triage",
      "label": "Triage",
      "kind": "deterministic",
      "hard_gate": false,
      "requirements": [
        {
          "key": "fetch_probe",
          "label": "Fetch/source probe før dyre trin",
          "value": 1,
          "unit": "probe",
          "adjustable": false
        },
        {
          "key": "risk_flag",
          "label": "High-risk/right-of-reply klassificeret",
          "value": 1,
          "unit": "flag",
          "adjustable": false
        },
        {
          "key": "media_scout",
          "label": "Tidlig documentary media-scout",
          "value": 1,
          "unit": "scout",
          "adjustable": false
        }
      ]
    },
    {
      "id": "research",
      "label": "Research",
      "kind": "evidence",
      "hard_gate": true,
      "requirements": [
        {
          "key": "min_readable_strong_source_chars",
          "label": "Minimum læsbart uddrag fra stærk/primær kilde",
          "value": 80,
          "unit": "tegn",
          "adjustable": true
        },
        {
          "key": "min_readable_standard_source_chars",
          "label": "Minimum læsbart uddrag fra standardkilde",
          "value": 120,
          "unit": "tegn",
          "adjustable": true
        },
        {
          "key": "min_distinct_sources",
          "label": "Minimum dokumentationskilder",
          "value": 1,
          "unit": "kilde",
          "adjustable": true
        },
        {
          "key": "target_source_groups",
          "label": "Mål for bredde når relevant",
          "value": 3,
          "unit": "kildegrupper",
          "adjustable": true
        }
      ]
    },
    {
      "id": "fact_check",
      "label": "Fact check",
      "kind": "evidence",
      "hard_gate": true,
      "requirements": [
        {
          "key": "min_verified_material_claims",
          "label": "Verificerede bærende claims",
          "value": 1,
          "unit": "claim",
          "adjustable": true
        },
        {
          "key": "evidence_class_rule",
          "label": "Lavrisiko evidensklasse A-D",
          "value": 1,
          "unit": "gyldig klasse",
          "adjustable": false
        },
        {
          "key": "numeric_conflict_check",
          "label": "Tal skal aktivt falsificeres og mismatch håndteres",
          "value": 1,
          "unit": "check",
          "adjustable": false
        }
      ]
    },
    {
      "id": "desk_recheck",
      "label": "Newsdesk recheck",
      "kind": "editorial",
      "hard_gate": false,
      "requirements": [
        {
          "key": "mode",
          "label": "Kun A/breaking AI-recheck; ellers deterministisk",
          "value": 1,
          "unit": "regel",
          "adjustable": false
        }
      ]
    },
    {
      "id": "journalist",
      "label": "Journalist",
      "kind": "production",
      "hard_gate": false,
      "requirements": [
        {
          "key": "min_body_blocks",
          "label": "Minimum tekstblokke",
          "value": 3,
          "unit": "blokke",
          "adjustable": true
        },
        {
          "key": "max_body_blocks",
          "label": "Maksimum tekstblokke",
          "value": 14,
          "unit": "blokke",
          "adjustable": true
        }
      ]
    },
    {
      "id": "polish",
      "label": "Sprog & SEO",
      "kind": "quality",
      "hard_gate": false,
      "requirements": [
        {
          "key": "max_auto_repair_cycles",
          "label": "Automatiske reparationsforsøg",
          "value": 1,
          "unit": "forsøg",
          "adjustable": true
        }
      ]
    },
    {
      "id": "ethics",
      "label": "Etik & fairness",
      "kind": "safety",
      "hard_gate": true,
      "requirements": [
        {
          "key": "blocking_ethics_issues",
          "label": "Tilladte blokerende etikfejl",
          "value": 0,
          "unit": "fejl",
          "adjustable": false
        },
        {
          "key": "right_of_reply_unresolved",
          "label": "Uafklaret forelæggelse",
          "value": 0,
          "unit": "sager",
          "adjustable": false
        }
      ]
    },
    {
      "id": "image",
      "label": "Hero-integritet",
      "kind": "safety",
      "hard_gate": true,
      "requirements": [
        {
          "key": "documentary_first",
          "label": "Media-scout skal forsøge lovligt dokumentarisk media før illustration",
          "value": 1,
          "unit": "regel",
          "adjustable": false
        },
        {
          "key": "no_photo_is_soft",
          "label": "Intet foto fundet giver pending illustration – ikke hold",
          "value": 1,
          "unit": "regel",
          "adjustable": false
        },
        {
          "key": "truthful_context",
          "label": "Foto/still skal have sand context_type og caption ved ikke-event",
          "value": 1,
          "unit": "regel",
          "adjustable": false
        },
        {
          "key": "ai_integrity",
          "label": "Pending AI-hero skal være tydelig ikke-fotorealistisk illustration",
          "value": 1,
          "unit": "regel",
          "adjustable": false
        }
      ]
    },
    {
      "id": "final_editor",
      "label": "Slutredaktør",
      "kind": "editorial",
      "hard_gate": true,
      "requirements": [
        {
          "key": "ai_scope",
          "label": "AI-final kun high-risk/A-B/kontradiktion; lavrisiko deterministisk",
          "value": 1,
          "unit": "regel",
          "adjustable": false
        }
      ]
    },
    {
      "id": "publisher",
      "label": "Publisher",
      "kind": "release",
      "hard_gate": true,
      "requirements": [
        {
          "key": "required_safety_pass",
          "label": "PASS på fact/ethics/image/final safety",
          "value": 4,
          "unit": "gates",
          "adjustable": false
        }
      ]
    },
    {
      "id": "live_qa",
      "label": "Live QA",
      "kind": "release",
      "hard_gate": true,
      "requirements": [
        {
          "key": "critical_live_errors",
          "label": "Tilladte kritiske live-fejl",
          "value": 0,
          "unit": "fejl",
          "adjustable": false
        }
      ]
    }
  ]
}
